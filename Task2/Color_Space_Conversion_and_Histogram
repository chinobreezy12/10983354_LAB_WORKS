import cv2
import matplotlib.pyplot as plt

def process_and_analyze_image(image_path):
    """
    Loads a color image, converts it to different color spaces,
    displays and saves each converted image, and plots the grayscale histogram.

    Args:
        image_path (str): The path to the image file.
    """
    try:
        # Load the original color image
        color_image = cv2.imread(image_path)
        if color_image is None:
            raise FileNotFoundError(f"Image not found at {image_path}")
    except Exception as e:
        print(f"Error loading image: {e}")
        return

    # --- Color Space Conversions ---

    # 1. Convert to Grayscale
    gray_image = cv2.cvtColor(color_image, cv2.COLOR_BGR2GRAY)
    cv2.imwrite("photo_grayscale.jpg", gray_image)
    print("Grayscale image saved as photo_grayscale.jpg")

    # 2. Convert to HSV (Hue, Saturation, Value)
    hsv_image = cv2.cvtColor(color_image, cv2.COLOR_BGR2HSV)
    cv2.imwrite("photo_hsv.jpg", hsv_image)
    print("HSV image saved as photo_hsv.jpg")

    # 3. Convert to LAB (Luminosity, A, B)
    lab_image = cv2.cvtColor(color_image, cv2.COLOR_BGR2LAB)
    cv2.imwrite("photo_lab.jpg", lab_image)
    print("LAB image saved as photo_lab.jpg")

    # --- Displaying Images ---

    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    fig.suptitle('Color Space Conversions', fontsize=16)

    # Display Original Image (converted from BGR to RGB for correct colors)
    axes[0, 0].imshow(cv2.cvtColor(color_image, cv2.COLOR_BGR2RGB))
    axes[0, 0].set_title("Original Image")
    axes[0, 0].axis('off')

    # Display Grayscale Image
    axes[0, 1].imshow(gray_image, cmap='gray')
    axes[0, 1].set_title("Grayscale Image")
    axes[0, 1].axis('off')

    # Display HSV Image (note: Matplotlib needs RGB for display)
    axes[1, 0].imshow(cv2.cvtColor(hsv_image, cv2.COLOR_HSV2RGB))
    axes[1, 0].set_title("HSV Image")
    axes[1, 0].axis('off')

    # Display LAB Image (note: Matplotlib needs RGB for display)
    axes[1, 1].imshow(cv2.cvtColor(lab_image, cv2.COLOR_LAB2RGB))
    axes[1, 1].set_title("LAB Image")
    axes[1, 1].axis('off')

    plt.tight_layout()
    plt.show()

    # --- Histogram Plotting ---

    # Calculate histogram for the grayscale image
    # cv2.calcHist is more efficient for this
    hist = cv2.calcHist([gray_image], [0], None, [256], [0, 256])

    plt.figure(figsize=(8, 6))
    plt.title("Grayscale Image Histogram")
    plt.xlabel("Pixel Intensity")
    plt.ylabel("Frequency")
    plt.plot(hist)
    plt.xlim([0, 256])
    plt.grid()
    plt.show()

# Make sure to replace 'photo.jpg' with the path to your actual image file.
if __name__ == '__main__':
    process_and_analyze_image('photo.jpg')
